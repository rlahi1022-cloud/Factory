// 통계 페이지
IDD_PAGE_STATS DIALOGEX 0, 0, 900, 490
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 9, "Tahoma", 0, 0, 0x1
BEGIN
    GROUPBOX    "Filter",           IDC_STATIC,   4,  4,890, 28
