/////////////////////////////////////////////////////////////////////////////
// 아이콘
IDR_MAINFRAME           ICON         "res\\Factory_UI_CL.ico"

#if !defined(AFX_RESOURCE_DLL) || defined(AFX_TARG_KOR)
LANGUAGE 18, 1

/////////////////////////////////////////////////////////////////////////////
// 메뉴
IDR_MAINMENU MENU
BEGIN
    POPUP "파일(&F)"
    BEGIN
        MENUITEM "로그아웃(&L)",         ID_FILE_LOGOUT
        MENUITEM SEPARATOR
        MENUITEM "종료(&X)",            ID_FILE_EXIT
    END
    POPUP "보기(&V)"
    BEGIN
        MENUITEM "새로고침(&R)\tF5",    ID_VIEW_REFRESH
    END
    POPUP "검사(&I)"
    BEGIN
        MENUITEM "검사 시작(&S)",        ID_INSPECT_START
        MENUITEM "검사 중지(&T)",        ID_INSPECT_STOP
    END
    POPUP "도움말(&H)"
    BEGIN
        MENUITEM "정보(&A)...",          ID_HELP_ABOUT
    END
END

/////////////////////////////////////////////////////////////////////////////
// 기존 About/Main 다이얼로그 (VS 자동생성 유지)
IDD_ABOUTBOX DIALOGEX 0, 0, 170, 62
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Factory_UI_CL 정보"
FONT 9, "MS Shell Dlg"
BEGIN
    ICON            IDR_MAINFRAME,IDC_STATIC,14,14,21,20
    LTEXT           "Factory QC v0.12",IDC_STATIC,42,14,114,8,SS_NOPREFIX
    LTEXT           "Copyright (C) 2026",IDC_STATIC,42,26,114,8
    DEFPUSHBUTTON   "확인",IDOK,113,41,50,14,WS_GROUP
END

IDD_FACTORY_UI_CL_DIALOG DIALOGEX 0, 0, 320, 200
STYLE DS_SHELLFONT | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_THICKFRAME | WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "Factory QC"
FONT 9, "MS Shell Dlg"
BEGIN
    DEFPUSHBUTTON   "확인",IDOK,209,179,50,14
    PUSHBUTTON      "취소",IDCANCEL,263,179,50,14
END

/////////////////////////////////////////////////////////////////////////////
// 로그인 다이얼로그
IDD_LOGIN_DLG DIALOGEX 0, 0, 260, 210
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Factory QC - Login"
FONT 9, "Tahoma", 0, 0, 0x1
BEGIN
    // ── 사원 ID (회원가입 모드에서만 표시) ──
    LTEXT           "사원 ID:",         1008,               14, 36, 52, 10
    EDITTEXT                            IDC_EDIT_EMPID,     70, 34,174, 14, ES_AUTOHSCROLL

    // ── 사용자 이름 (공통) ──
    LTEXT           "사용자(&U):",      IDC_STATIC,         14, 56, 52, 10
    EDITTEXT                            IDC_EDIT_USERNAME,  70, 54,174, 14, ES_AUTOHSCROLL

    // ── 암 호 (공통) ──
    LTEXT           "암 호(&P):",       IDC_STATIC,         14, 76, 52, 10
    EDITTEXT                            IDC_EDIT_PASSWORD,  70, 74,174, 14, ES_AUTOHSCROLL | ES_PASSWORD

    // ── 암호 확인 (회원가입 모드에서만 표시) ──
    LTEXT           "암호 확인:",       1009,               14, 96, 52, 10
    EDITTEXT                            IDC_EDIT_PASS_CONFIRM, 70, 94,174, 14, ES_AUTOHSCROLL | ES_PASSWORD

    // ── 권한 등급 (회원가입 모드에서만 표시) ──
    LTEXT           "권한 등급:",       1010,               14,116, 52, 10
    COMBOBOX                            IDC_COMBO_ROLE,     70,114,174, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    // ── 에러 메시지 ──
    LTEXT           "",                 IDC_STATIC_ERROR,   14,138,210, 10, SS_LEFT

    // ── 하단 버튼 ──
    PUSHBUTTON      "회원가입 →",       IDC_BTN_SWITCH_MODE, 14,160, 70, 14
    DEFPUSHBUTTON   "확인",             IDOK,               168,160, 40, 14
    PUSHBUTTON      "취소",             IDCANCEL,           212,160, 40, 14
END

