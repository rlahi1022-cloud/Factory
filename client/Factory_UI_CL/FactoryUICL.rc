// 모델 페이지
IDD_PAGE_MODEL DIALOGEX 0, 0, 900, 490
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 9, "Tahoma", 0, 0, 0x1
BEGIN
    GROUPBOX "Model Versions",      IDC_STATIC,   4,  4,890,112
    CONTROL  "", IDC_LIST_MODELS, "SysListView32",
             LVS_REPORT | LVS_SINGLESEL | WS_BORDER | WS_CHILD | WS_VISIBLE | WS_VSCROLL,
             10, 16,876, 94
