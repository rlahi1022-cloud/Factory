END

/////////////////////////////////////////////////////////////////////////////
// 버전 정보
VS_VERSION_INFO VERSIONINFO
  FILEVERSION    0,12,0,0
  PRODUCTVERSION 0,12,0,0
  FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
  FILEFLAGS VS_FF_DEBUG
#else
  FILEFLAGS 0x0L
#endif
  FILEOS VOS_NT_WINDOWS32
  FILETYPE VFT_APP
  FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041204B0"
        BEGIN
            VALUE "FileDescription", "Factory QC Vision System"
            VALUE "FileVersion",     "0.12.0.0"
            VALUE "ProductName",     "FactoryQC"
            VALUE "ProductVersion",  "0.12.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0412, 1200
    END
END

