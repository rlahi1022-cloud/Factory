             LVS_REPORT | LVS_SINGLESEL | WS_BORDER | WS_CHILD | WS_VISIBLE,
             278, 28,202, 64
    GROUPBOX "PatchCore Label",     IDC_STATIC,         274,102,210, 26
    LTEXT    "Score: 0.00",         IDC_STATIC_S2_SCORE, 282,112,196, 10
    GROUPBOX "Final Result",        IDC_STATIC,         274,132,210, 52
    LTEXT    "OK",                  IDC_STATIC_S2_RESULT, 284,142,190, 36, SS_CENTER
    PUSHBUTTON "Select Defect",     IDC_BTN_S2_DEFECT,  274,192, 80, 14
    PUSHBUTTON "Rework",            IDC_BTN_S2_REWORK,  358,192, 60, 14
    GROUPBOX "Arduino - Station2",  IDC_STATIC,           4,318,890, 36
    LTEXT    "Serial OK (COM5)",    IDC_STATIC,          12,330,110, 10
    LTEXT    "Standby",             IDC_STATIC_S2_LED,  130,330,220, 10
END

