    CONTROL  "", IDC_LIST_UPLOADED,"SysListView32",
             LVS_REPORT | LVS_SINGLESEL | WS_BORDER | WS_CHILD | WS_VISIBLE,
             12,180,490, 44
    PUSHBUTTON "Start Retrain",     IDC_BTN_RETRAIN,        12,230, 70, 14
    CONTROL  "", IDC_PROGRESS_TRAINING, "msctls_progress32",
             WS_CHILD | WS_VISIBLE, 88,232,340, 12
    LTEXT    "",                    IDC_STATIC_TRAIN_STATUS, 88,248,400, 10
    GROUPBOX "Server Info",         IDC_STATIC,   4,288,890, 58
    LTEXT    "Server:    Ubuntu 24.04 + CUDA 12.x",  IDC_STATIC, 12,300,400, 10
    LTEXT    "GPU:       NVIDIA RTX Series",          IDC_STATIC, 12,312,400, 10
