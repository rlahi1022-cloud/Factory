/////////////////////////////////////////////////////////////////////////////
// 스테이션 1
IDD_PAGE_STATION1 DIALOGEX 0, 0, 900, 490
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 9, "Tahoma", 0, 0, 0x1
BEGIN
    GROUPBOX "Station 1 - Incoming (PatchCore)", IDC_STATIC, 4, 4, 890, 310
    LTEXT    "Pylon Camera #1",     IDC_STATIC,          10, 18,140,  9
    CONTROL  "", IDC_CAM1_VIEW,    "STATIC", SS_BLACKFRAME | WS_CHILD | WS_VISIBLE, 10, 28,155,215
    LTEXT    "PatchCore Heatmap",   IDC_STATIC,         172, 18, 90,  9
    CONTROL  "", IDC_HEATMAP1_VIEW,"STATIC", SS_BLACKFRAME | WS_CHILD | WS_VISIBLE,172, 28, 95,215
    GROUPBOX "Result",              IDC_STATIC,         274, 18,210, 80
    LTEXT    "OK",                  IDC_STATIC_S1_RESULT, 284, 28,190, 42, SS_CENTER
    LTEXT    "Score: 0.00 / Thresh: 0.50", IDC_STATIC_S1_SCORE, 282, 72,196, 10
    GROUPBOX "Settings",            IDC_STATIC,         274,102,210, 74
    LTEXT    "Model:  PatchCore v1.2.0", IDC_STATIC,    282,114,196, 10
    LTEXT    "Input:  224x224",     IDC_STATIC,         282,126,196, 10
    LTEXT    "Thresh: 0.50",        IDC_STATIC,         282,138,196, 10
    LTEXT    "Backbone: ResNet-18", IDC_STATIC,         282,150,196, 10
    PUSHBUTTON "Manual: OK",        IDC_BTN_S1_OK,      274,184, 66, 14
    PUSHBUTTON "Manual: NG",        IDC_BTN_S1_NG,      344,184, 66, 14
    PUSHBUTTON "Arduino Test",      IDC_BTN_S1_ARDUINO, 414,184, 60, 14
    GROUPBOX "Arduino - Station1",  IDC_STATIC,           4,318,890, 36
    LTEXT    "Serial OK (COM3)",    IDC_STATIC,          12,330,110, 10
    LTEXT    "Standby",             IDC_STATIC_S1_LED,  130,330,220, 10
END

/////////////////////////////////////////////////////////////////////////////
// 스테이션 2
IDD_PAGE_STATION2 DIALOGEX 0, 0, 900, 490
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 9, "Tahoma", 0, 0, 0x1
