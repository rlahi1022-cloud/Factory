/////////////////////////////////////////////////////////////////////////////
// 홈 페이지
IDD_PAGE_HOME DIALOGEX 0, 0, 900, 490
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 9, "Tahoma", 0, 0, 0x1
BEGIN
    // v0.14.7: Summary 컬럼 정렬 정리 + Uptime 제거.
    //   - 라벨/값 모두 같은 x/width 로 정렬 (둘 다 SS_CENTER)
    //   - 컬럼 간격 100px 고정, "Defect Rate" 라벨이 잘리지 않도록 width=90
    //   - Uptime 라벨/값 삭제 (서버측 실 데이터 없음)
    GROUPBOX        "Summary",             IDC_STATIC,       4,   4, 890, 58
    LTEXT           "Total",               IDC_STATIC,      20,  16,  90,  9, SS_CENTER
    LTEXT           "0",                   IDC_STATIC_TOTAL,20,  26,  90, 18, SS_CENTER
    LTEXT           "OK",                  IDC_STATIC,     120,  16,  90,  9, SS_CENTER
    LTEXT           "0",                   IDC_STATIC_OK,  120,  26,  90, 18, SS_CENTER
    LTEXT           "NG",                  IDC_STATIC,     220,  16,  90,  9, SS_CENTER
    LTEXT           "0",                   IDC_STATIC_NG,  220,  26,  90, 18, SS_CENTER
    LTEXT           "Defect Rate",         IDC_STATIC,     320,  16,  90,  9, SS_CENTER
    LTEXT           "0.00%",               IDC_STATIC_DEFECT_RATE, 320, 26, 90, 18, SS_CENTER
    GROUPBOX        "NG History",          IDC_STATIC,        4, 66,890,200
    CONTROL         "", IDC_LIST_NG, "SysListView32",
                    LVS_REPORT | LVS_SINGLESEL | WS_BORDER | WS_CHILD | WS_VISIBLE | WS_VSCROLL,
                    10, 78,876,182
END

/////////////////////////////////////////////////////////////////////////////
// 스테이션 1
IDD_PAGE_STATION1 DIALOGEX 0, 0, 900, 720
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 9, "Tahoma", 0, 0, 0x1
BEGIN
    // ── 메인 그룹박스 (3뷰 + 우측 패널 포함) ─────────────────────────────
    GROUPBOX "Station 1 - Incoming (PatchCore)", IDC_STATIC, 4, 4, 890, 270

    // ── 뷰 레이블 (각 뷰 상단) ────────────────────────────────────────────
    // 뷰 3개: x=10/201/392, 각 w=185, h=222
    // 간격: 6du, 레이블 높이: 9du (y=18), 뷰 y=28
    LTEXT    "Image",                 IDC_STATIC,          10, 18, 60,  9
    LTEXT    "Image + Anomaly Map",   IDC_STATIC,         201, 18,100,  9
    LTEXT    "Image + Pred Mask",     IDC_STATIC,         392, 18, 90,  9

    // ── 3개 뷰 컨트롤 (균등 185×222) ──────────────────────────────────────
    CONTROL  "", IDC_CAM1_VIEW,      "STATIC", SS_BLACKFRAME | WS_CHILD | WS_VISIBLE,  10, 28, 185, 222
    CONTROL  "", IDC_HEATMAP1_VIEW,  "STATIC", SS_BLACKFRAME | WS_CHILD | WS_VISIBLE, 201, 28, 185, 222
    CONTROL  "", IDC_PREDMASK1_VIEW, "STATIC", SS_BLACKFRAME | WS_CHILD | WS_VISIBLE, 392, 28, 185, 222

    // ── 우측 패널 (Result / Settings / 버튼) ─────────────────────────────
    // x=583 (392+185+6), w=210
    GROUPBOX "Result",                IDC_STATIC,         583, 14, 210,  80
    LTEXT    "OK",                    IDC_STATIC_S1_RESULT, 593, 24, 190, 42, SS_CENTER
    LTEXT    "Score: 0.00 / Thresh: 0.50", IDC_STATIC_S1_SCORE, 591, 68, 196, 10

    GROUPBOX "Settings",              IDC_STATIC,         583,  98, 210,  74
    LTEXT    "Model:",                IDC_STATIC,         591, 110,  40,  10
    LTEXT    "",                      IDC_STATIC_S1_CFG_MODEL,  633, 110, 154, 10
    LTEXT    "Input:",                IDC_STATIC,         591, 122,  40,  10
    LTEXT    "",                      IDC_STATIC_S1_CFG_INPUT,  633, 122, 154, 10
    LTEXT    "Thresh:",               IDC_STATIC,         591, 134,  40,  10
    LTEXT    "",                      IDC_STATIC_S1_CFG_THRESH, 633, 134, 154, 10
    LTEXT    "Backbone:",             IDC_STATIC,         591, 146,  40,  10
    LTEXT    "",                      IDC_STATIC_S1_CFG_BACKBONE,633,146, 154, 10

    // v0.14.7: Manual OK/NG/Arduino 테스트 버튼 제거 — 실서버 데이터만 사용.

    // v0.15.2: 1공정 검사 Start/Stop 버튼 (INSPECT_CONTROL_REQ station_filter=1)
    //   Settings 박스(y=98~172) 바로 아래 y=180 위치에 가로 2개 배치.
    //   핸들러: CPageStation1::OnBtnS1Start / OnBtnS1Stop
    PUSHBUTTON "검사 시작",           IDC_BTN_S1_START,   583, 180, 100, 16
    PUSHBUTTON "검사 중지",           IDC_BTN_S1_STOP,    689, 180, 100, 16

    // ── 아두이노 상태바 ───────────────────────────────────────────────────
    GROUPBOX "Arduino - Station1",    IDC_STATIC,           4, 282, 890, 36
    LTEXT    "Serial OK (COM3)",      IDC_STATIC,          12, 294, 110, 10
    LTEXT    "Standby",               IDC_STATIC_S1_LED,  130, 294, 220, 10

    // ── NG 이벤트 이력 (최대 10건, 세로 리스트, 스크롤) ─────────────────
    // v0.14.5: 텍스트 전용 컬럼 [ID|스테이션|시각|결과|점수] — CNgHistoryList가 소유드로우.
    //  상단 3뷰(CCameraView/CHeatmapView/CPredMaskView)에서 실이미지 확인하므로
    //  하단 이력은 메타정보만 표시 (종합현황 PageHome 의 NG 리스트와 동일 컨셉).
    LTEXT    "NG 이벤트 이력 (최근 10건)", IDC_STATIC,    10, 324,250, 10
    CONTROL  "", IDC_NG_LIST1, "STATIC",
             SS_BLACKFRAME | WS_CHILD | WS_VISIBLE | WS_VSCROLL | WS_TABSTOP,
             4, 336, 890, 380
END

/////////////////////////////////////////////////////////////////////////////
// 스테이션 2
// 레이아웃 변경 이력:
//   v0.14 — 좌측 이미지 3분할 확대(각 w=176, h=390), 우측 패널 x=542 시작
//           2번 이미지 레이아웃 기준으로 재설계
// ─────────────────────────────────────────────────────────────────────────
// 전체 다이얼로그 크기: 900 × 490
//
// [A] 좌측 이미지 3분할
//     GroupBox : x=4,   y=4,  w=534, h=430
//     뷰 3개   : 각 w=172, h=390, y=28
//       cam      x=8
//       heatmap  x=184
//       predmask x=360
//     결과 바  : y=422, h=14
//
// [B] 우측 정보 패널
//     x=542, w=354 (542+354=896 ≈ 900)
//     YOLO Detections  : y=4,   h=80
//     PatchCore Label  : y=88,  h=26
//     Final Result     : y=118, h=50
//     버튼             : y=172
//     구분선           : y=190
//     카테고리 버튼    : y=194
//     설명 레이블      : y=212
//     NG 이력 헤더     : y=224
//     NG 리스트        : y=236, h=190  (충분히 크게)
//
// [C] 아두이노 상태바  : y=438, h=24  (전체 하단)
// ─────────────────────────────────────────────────────────────────────────
IDD_PAGE_STATION2 DIALOGEX 0, 0, 900, 490
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 9, "Tahoma", 0, 0, 0x1
BEGIN
    // ══════════════════════════════════════════════════════════════════
    // [A] 좌측: Station 그룹박스 + 이미지 3분할
    // ══════════════════════════════════════════════════════════════════
    GROUPBOX "Station 2 - Assembly (YOLO11 + PatchCore)", IDC_STATIC,
             4, 4, 534, 430

    // 레이블 (y=18)
    LTEXT    "이미지",          IDC_STATIC,  8,  18, 172,  9
    LTEXT    "Anomaly Heatmap", IDC_STATIC, 184, 18, 172,  9
    LTEXT    "Pred Mask",       IDC_STATIC, 360, 18, 172,  9

    // 이미지 뷰 3개 (y=28, h=390)
    CONTROL  "", IDC_CAM2_VIEW,      "STATIC", SS_BLACKFRAME | WS_CHILD | WS_VISIBLE,
               8, 28, 172, 390
    CONTROL  "", IDC_HEATMAP2_VIEW,  "STATIC", SS_BLACKFRAME | WS_CHILD | WS_VISIBLE,
             184, 28, 172, 390
    CONTROL  "", IDC_PREDMASK2_VIEW, "STATIC", SS_BLACKFRAME | WS_CHILD | WS_VISIBLE,
             360, 28, 172, 390

    // OK/NG 결과 바 (y=422, h=14) — PageStation2.cpp 에서 배경색 변경
    LTEXT    "OK", IDC_STATIC_S2_RESULT,  8, 422, 524, 14, SS_CENTER

    // ══════════════════════════════════════════════════════════════════
    // [B] 우측: 정보 패널 (x=542, w=354)
    // ══════════════════════════════════════════════════════════════════

    // [B-1] YOLO11 Detections (y=4, h=80)
    GROUPBOX "YOLO11 Detections",  IDC_STATIC,       542,  4, 354,  80
    CONTROL  "", IDC_LIST_YOLO,  "SysListView32",
             LVS_REPORT | LVS_SINGLESEL | WS_BORDER | WS_CHILD | WS_VISIBLE,
             546, 16, 346,  62

    // [B-2] PatchCore Label (y=88, h=26)
    GROUPBOX "PatchCore Label",    IDC_STATIC,       542, 88, 354,  26
    LTEXT    "PatchCore 이상 점수: 0.00", IDC_STATIC_S2_SCORE,
             548, 98, 342,  10

    // [B-3] Final Result (y=118, h=50)
    GROUPBOX "Final Result",       IDC_STATIC,       542,118, 354,  50
    LTEXT    "OK",                 IDC_STATIC_S2_RESULT_PANEL,
             548,130, 342,  32, SS_CENTER

    // [B-4] 액션 버튼 (y=172)
    PUSHBUTTON "Select Defect",    IDC_BTN_S2_DEFECT, 542,172, 100,  14
    PUSHBUTTON "Rework",           IDC_BTN_S2_REWORK, 646,172,  80,  14

    // [B-5] 구분선 (y=190)
    LTEXT    "", IDC_STATIC,                           542,190, 354,   1, SS_SUNKEN

    // [B-6] 카테고리 버튼 (y=194)
    LTEXT    "이미지 뷰:",         IDC_STATIC,        542,197,  48,  12
    PUSHBUTTON "전체",             IDC_BTN_S2_CAT_ALL, 592,194,  46,  14
    PUSHBUTTON "YOLO",             IDC_BTN_S2_CAT_YOLO,642,194,  46,  14
    PUSHBUTTON "PatchCore",        IDC_BTN_S2_CAT_PC,  692,194,  72,  14

    LTEXT    "현재 검사 결과 이미지 표시 중", IDC_STATIC_S2_CAT_DESC,
             542,212, 354,   9

    // [B-7] NG 이벤트 이력 리스트 (y=224~430)
    //  컬럼: 시각(54) | 분류(44) | 불량 유형(160) | 점수(44)
    LTEXT    "× NG 이벤트 이력",  IDC_STATIC,        542,224, 200,   9
    LTEXT    "금일 0건",           IDC_STATIC_S2_NG_COUNT,
             770,224, 126,   9
    CONTROL  "", IDC_NG_LIST2,  "SysListView32",
             LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS |
             WS_BORDER | WS_CHILD | WS_VISIBLE | WS_VSCROLL,
             542,236, 354, 198

    // v0.15.2: 2공정 검사 Start/Stop 버튼 (INSPECT_CONTROL_REQ station_filter=2)
    //   Station1 과 동일 패턴. DEFECT/REWORK 자리 상단(y=154) 에 가로 2개.
    //   핸들러: CPageStation2::OnBtnS2Start / OnBtnS2Stop
    PUSHBUTTON "검사 시작",         IDC_BTN_S2_START,   542, 154, 100, 16
    PUSHBUTTON "검사 중지",         IDC_BTN_S2_STOP,    646, 154, 100, 16

    // ══════════════════════════════════════════════════════════════════
    // [C] 아두이노 상태바 (y=438, h=24, 전체 폭)
    // ══════════════════════════════════════════════════════════════════
    GROUPBOX "Arduino - Station2", IDC_STATIC,          4,438, 892,  26
    LTEXT    "Serial",             IDC_STATIC,           10,450,  28,   9
    LTEXT    "● OK (COM5)",       IDC_STATIC_S2_SERIAL,  40,450,  70,   9
    LTEXT    "상태",               IDC_STATIC,           118,450,  24,   9
    LTEXT    "대기중",             IDC_STATIC_S2_LED,    144,450,  50,   9
    LTEXT    "마지막 신호",        IDC_STATIC,           202,450,  52,   9
    LTEXT    "--:--:--",           IDC_STATIC_S2_LAST,   256,450,  52,   9
    LTEXT    "Solenoid",           IDC_STATIC,           316,450,  40,   9
    LTEXT    "OFF",                IDC_STATIC_S2_SOL,    358,450,  30,   9
    LTEXT    "Sensor",             IDC_STATIC,           396,450,  32,   9
    LTEXT    "● Ready",           IDC_STATIC_S2_SENS,   430,450,  60,   9
END

