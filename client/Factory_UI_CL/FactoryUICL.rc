    CONTROL     "", IDC_DATE_FROM, "SysDateTimePick32",
                DTS_SHORTDATEFORMAT | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 38, 14, 84, 14
    LTEXT       "~",                IDC_STATIC,  124, 16,  8, 10
    CONTROL     "", IDC_DATE_TO,   "SysDateTimePick32",
                DTS_SHORTDATEFORMAT | WS_CHILD | WS_VISIBLE | WS_TABSTOP,134, 14, 84, 14
    COMBOBOX                        IDC_COMBO_STATION_FILTER, 224, 14, 90, 60,
                CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON  "Query",            IDC_BTN_QUERY,      320, 14, 36, 14
    PUSHBUTTON  "Export CSV",       IDC_BTN_EXPORT_CSV, 360, 14, 60, 14
END

