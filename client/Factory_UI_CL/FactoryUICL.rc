    LTEXT    "Target:",             IDC_STATIC,   12,132, 30, 10
    COMBOBOX                        IDC_COMBO_TARGET, 46,130,180, 60,
             CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
