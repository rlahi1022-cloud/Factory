{
  "network": {
    "main_server_host": "10.10.10.130",
    "main_server_ai_port": 9000,
    "main_server_gui_port": 9010,
    "training_server_host": "10.10.10.120",
    "training_server_port": 9100,
    "allowed_ip_prefixes": ["10.", "192.168.", "172.16.", "127.0.0.1"]
  },

  "database": {
    "host": "127.0.0.1",
    "port": 3306,
    "user": "factorymanager",
    "password": "1234",
    "schema": "Factory",
    "pool_size": 4,
    "acquire_timeout_sec": 5
  },

  "storage": {
    "image_root": "./storage",
    "model_root": "./storage/models",
    "log_dir": "./logs"
  },

  "limits": {
    "json_max_bytes": 65536,
    "image_max_bytes": 52428800,
    "model_max_bytes": 524288000,
    "event_queue_max": 10000,
    "max_ai_connections": 10,
    "max_gui_sessions": 20
  },

  "health_check": {
    "interval_sec": 5,
    "_comment": "v0.11.0: ip 는 선택사항. 비어있으면 server_type(=name) 으로 동적 매칭 — 다른 PC 에 배치되어도 자동 감지.",
    "targets": [
      { "name": "ai_inference_1", "ip": "", "port": 9000 },
      { "name": "ai_inference_2", "ip": "", "port": 9000 },
      { "name": "ai_training",    "ip": "", "port": 9000 }
    ]
  },

  "ai_server": {
    "_comment_camera": "camera_enabled=false → 더미 이미지 모드, camera_serial 빈값 → 첫 번째 Basler 장치 사용",
    "station1": {
      "model_path": "./models/station1_patchcore.ckpt",
      "patchcore_input_size": 224,
      "anomaly_threshold": 0.5,
      "device": "auto",
      "grab_queue_max": 16,
      "inference_workers": 1,
      "sender_workers": 1,
      "camera_enabled": true,
      "camera_serial": "",
      "camera_fps": 2.0,
      "_comment_test_mode": "camera_enabled=false + test_image_dir 지정 시 폴더 이미지를 카메라 대신 순환 재생",
      "test_image_dir": "./data/station1/test",
      "_comment_arduino": "arduino_port: Windows=\"COM3\" / Linux=\"/dev/ttyUSB0\" / null=미사용",
      "arduino_port": "COM3",
      "arduino_baud": 9600
    },
    "station2": {
      "model_path": "./models/station2_yolo.pt",
      "_comment_patchcore": "v0.15.4: Station2 는 YOLO11 단독 확정. 빈 값 → Station2Inferencer 가 자동 skip 하고 YOLO 판정만 사용.",
      "patchcore_model_path": "",
      "yolo_conf_threshold": 0.5,
      "yolo_iou_threshold": 0.45,
      "yolo_input_size": 640,
      "anomaly_threshold": 0.5,
      "device": "auto",
      "grab_queue_max": 16,
      "inference_workers": 1,
      "sender_workers": 1,
      "camera_enabled": true,
      "camera_serial": "40098234",
      "camera_fps": 2.0,
      "_comment_test_mode": "camera_enabled=false + test_image_dir 지정 시 폴더 이미지를 카메라 대신 순환 재생 (MFC 실시간 테스트용)",
      "test_image_dir": "./data/station2/yolo/images/test",
      "_comment_arduino": "arduino_port: Windows=\"COM5\" (Station2 전용) / Station1 과 공유 시 \"COM3\" / 미사용이면 null",
      "arduino_port": "COM5",
      "arduino_baud": 9600
    }
  },

  "training": {
    "listen_host": "0.0.0.0",
    "device": "cuda",
    "gpu_id": 0,
    "data_root": "./data",
    "model_output_dir": "./models",
    "patchcore_backbone": "wide_resnet50_2",
    "patchcore_input_size": 224,
    "patchcore_batch_size": 32,
    "yolo_base_model": "yolo11n.pt",
    "yolo_input_size": 640,
    "yolo_epochs": 100,
    "yolo_batch_size": 16,
    "yolo_patience": 20,
    "augmentation_factor": 5,
    "deploy_dir": "./deploy"
  },

  "client": {
    "default_server_ip": "10.10.10.130",
    "recv_buffer_size": 65536
  }
}
